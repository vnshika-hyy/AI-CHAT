# ---------- Backend ----------
# Comma-separated key pool, at least 2 keys. Ids become key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
# Any LiteLLM model name your keys can use (e.g. gemini/gemini-2.5-flash-lite, groq/llama-3.3-70b-versatile)
LLM_MODEL=gemini/gemini-2.5-flash-lite
# SQLite file. In Docker this is overridden to the /data volume.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated origins allowed by CORS (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test header (must be true on the deployed backend)
ENABLE_FAILURE_SIMULATION=true

# Optional
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
CACHE_ENABLED=true
REQUEST_TIMEOUT_SECONDS=30
KEY_COOLDOWN_SECONDS=20
# LLM_MAX_TOKENS=1024
# LLM_MOCK=true   # offline demo: canned replies, no API keys needed (never in production)

# ---------- Frontend (build-time) ----------
VITE_API_URL=http://localhost:8000
VITE_SHOW_TEST_TOOLS=true
